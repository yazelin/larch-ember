   "skippable": false,
   "description": "歌詞跟著秒數亮起，唱完自動往下。",
   "descriptionEn": "Lyrics follow the clock; continues when the song ends.",
   "readVariables": [],
   "writeVariables": [],
   "fields": [
    {
     "key": "lines",
     "kind": "longText",
     "label": "歌詞",
     "labelEn": "Lyrics",
     "defaultValue": "1.5｜第一句\n5.0｜第二句",
     "hint": "一行一句：「秒數｜歌詞」，秒數從進卡算起。間奏可以寫「♪」。"
    },
    {
     "key": "duration",
     "kind": "number",
     "label": "歌長（秒）",
     "labelEn": "Song length (s)",
     "min": 1,
     "max": 900,
     "step": 0.1,
     "defaultValue": 60,
     "hint": "歌唱完再停「結尾停留」秒才往下。"
    },
