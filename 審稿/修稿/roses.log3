from pathlib import Path
import re
import subprocess
s=Path('canon/劇本.md').read_text()
m=re.search(r'"'^## roses'"\\b["'^'"\\n]*',s,re.M)
e=re.search(r'"'^## '"',s[m.end():],re.M)
scene=s[m.start():m.end()+e.start() if e else len(s)]
changes={
'旁白：2006 年，散場後。後台門外右邊放著一朵深紅玫瑰，花梗夾著當晚的票根。':'旁白：2006 年，散場後。場務把一朵深紅玫瑰放在後台門外右邊，花梗夾著當晚的票根。',
'余靜：塞花就跑的？':'余靜：又是那個送完花就跑的喔？',
'余靜：下次叫他買三排十四號啦，我要找得到他。':'余靜：下次叫他買三排十四號啦，這樣我才找得到人。'
}
revised=scene
for old,new in changes.items():
    assert revised.count(old)==1
    revised=revised.replace(old,new,1)
before=scene.splitlines()
after=revised.splitlines()
assert len(before)==len(after)
changed=[i+1 for i,(a,b) in enumerate(zip(before,after)) if a"'!=b]
assert changed==[4,5,7], changed
assert after[0]==before[0]
assert all(not line or line.startswith('"'〔圖：') or '：' in line for line in after[1:])
print('僅第 4、5、7 行有改動；第 6 行保留，與場務放花的動作一致。',flush=True)
r=subprocess.run(['/home/ct/speak-tw/bin/speak-tw','--public','--stdin'],input=revised,text=True)
raise SystemExit(r.returncode)
