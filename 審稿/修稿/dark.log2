/bin/bash -lc "sed -n '1,240p' /home/ct/speak-tw/rules.mjs" in /home/ct/larch-ember
 succeeded in 0ms:
/* rules.mjs — 規則就是資料。每一條都要有「該抓的例子」和「不該抓的例子」,
   test/rules.test.mjs 會逐條驗:抓不到該抓的、或誤抓不該抓的,測試就掛。
   這樣才不會出現「為了多抓一點,regex 越寫越兇」的那種爛規則。

   register:
     any    —— 任何地方都算數
     public —— 只在對外文字算數(README 中文段、網頁文案、blog、貼文);
               內部的 commit、NEXT.md、spec 不套 */
/* 簡體字表原本是手寫的 130 字,漏一個字就靜默放行(2026-09-21 實際發生:Larch 插件
   manifest 裡的「换」跑了檢查器還是過)。改成反過來問:Big5 編得出來的就是正體,
   編不出來的 CJK 就當簡體。Big5 字表用 TextDecoder 現場解出來,不進相依、不進原始碼。 */
const BIG5_MISSING = '鿿堃喆坂媠嫲'; // Big5 漏收但正體在用:U+9FFF(正規表示式常拿來當端點)、人名用字、台語客語用字
const SIMPLIFIED = (() => {
  const bytes = [];
  for (let lead = 0x81; lead <= 0xfe; lead++)
    for (let trail = 0x40; trail <= 0xfe; trail++) bytes.push(lead, trail, 0x0a);
  const traditional = new Set(
    new TextDecoder('big5').decode(new Uint8Array(bytes)).split('\n').filter((c) => c.length === 1));
  for (const c of BIG5_MISSING) traditional.add(c);
  const hex = (cp) => '\\u' + cp.toString(16).padStart(4, '0');
  const parts = [];
  let start = null;
  for (let cp = 0x4e00; cp <= 0xa000; cp++) {
    const simp = cp < 0xa000 && !traditional.has(String.fromCodePoint(cp));
    if (simp && start === null) start = cp;
    if (!simp && start !== null) {
      parts.push(start === cp - 1 ? hex(start) : hex(start) + '-' + hex(cp - 1));
      start = null;
    }
  }
  return new RegExp('[' + parts.join('') + ']', 'g');
})();

export const RULES = [
  // ── 一、被指正過的實際案例(這份清單的價值所在) ──
  {
    id: 'fake-contrast', register: 'any', name: '「不是 X，是 Y」的假對比',
    why: '直接把 Y 講出來就好。這個句型是用來製造洞見感的,不傳達資訊。換行或句號斷開也算(「從來不是 X。是 Y。」)。',
    re: /[^。！？\n]{0,26}不是[^。！？\n]{0,24}(?:[，,][^。！？\n]{0,4}(?:是|而是)|[。！？\n]+\s*(?:就)?是(?!的|否))[^。！？\n]{0,20}/g,
    bad: '這不是省錢的小聰明，是整條產線的設計主軸',
    good: '這是整條產線的設計主軸，省錢只是順帶。它不是免費的。',
  },
  {
    id: 'never-punchline', register: 'any', name: '「從來沒有…過。」收尾的洞見句',
    why: '前面鋪一段，再補一句「他從來沒有 Y 過」當結語，是用絕對否定暗示一個對比、製造洞見感（2026-10-07 使用者抓到「他從來沒有坐在另一邊過」）。要嘛刪掉，讓前面的事自己說話；要嘛把要對比的那件事直接寫出來。台詞裡角色真的這樣說、或是單純交代事實的，那一行加 speak-tw-ok。',
    re: /(?:^|[。！？\n|])\s*[^。！？\n|]{0,12}從來(?:都)?(?:沒有|沒|不曾|未曾)[^，。！？\n|]{1,14}過[。！？]/g,
    bad: '他知道這個法子要問多久。他從來沒有坐在另一邊過。',
    good: '他從來沒有去過洛陽，這回跟著車隊走了十天才到。',
  },
  {
    id: 'pronoun-person', register: 'any', name: '「年輕的那個」這類用「的那個」代替人或物',
    why: '「年紀大的那個翻開資料夾」「年輕的那個問」「就是印在公文右下角的那一個」：用「形容詞＋的那個」撐場是 AI 味，讀者解得開也一樣（2026-10-09 使用者讀《十一分鐘》：「像這種『那個』的用法就是 AI 味，要去除乾淨」）。講出實際稱呼（年長的審訊員）或直接描述（跟公文右下角印的一模一樣）。',
