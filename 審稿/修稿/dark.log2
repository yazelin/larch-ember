/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import re, difflib
packet = Path('審稿/修稿/dark.packet.md').read_text()
numbered = packet.split('## 這一場（行號｜內容）\\n',1)[1].split('\\n## 問題：',1)[0]
rows = {int(m.group(1)):m.group(2) for m in re.finditer(r'"'^('"\\d+)｜(.*)"'$'"',numbered,re.M)}
old = '\\n'.join(rows.get(i,'') for i in range(1,max(rows)+1)) + '\\n'
new = Path('審稿/修稿/dark.md').read_text()
canon = re.search(r'"'^## dark[''^'"\\n]*\\n.*?(?="'^## |'"\\Z)',Path('canon/劇本.md').read_text(),re.M|re.S).group().rstrip() + '\\n'
assert old == canon, 'packet / canon mismatch'
assert len(new) <= len(old), (len(old),len(new))
assert new.startswith(rows[1]+'\\n')
old_lines, new_lines = old.splitlines(), new.splitlines()
assert len(old_lines) == len(new_lines)
allowed = {12,13,18,19,21,24,36}
changed = {i for i,(a,b) in enumerate(zip(old_lines,new_lines),1) if a "'!= b}
assert changed <= allowed, changed
for i,a in enumerate(old_lines):
    if a.startswith(('"'## ','〔圖：','選項：','- ')) or '〔掉字〕' in a or '（唱）' in a or '手錶型 GPS' in a:
        assert a == new_lines[i], (i+1,a,new_lines[i])
print(f'原稿 {len(old)} 字元；新稿 {len(new)} 字元。')
print('僅改修稿包原稿第 '+ '、'.join(map(str,sorted(changed))) + ' 行。')
print('標題、全部圖與掉字句、手錶扣回均逐字保留。')
print(''.join(difflib.unified_diff(old_lines,new_lines,fromfile='packet original',tofile='dark.md',lineterm='\\n')))
