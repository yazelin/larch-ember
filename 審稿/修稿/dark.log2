rows={int(n):s for n,s in re.findall(r'"'^('"\\d+)｜(.*)"'$'"',packet,re.M)}
packet_scene='\\n'.join(rows.get(i,'') for i in range(1,max(rows)+1))+'\\n'
assert packet_scene==original,'canon dark 與修稿包原稿不同'
new=Path('審稿/修稿/dark.md').read_text()
a,b=original.splitlines(),new.splitlines()
assert len(a)==len(b)==37
allowed={8,12,13,18,19,21,24,28}
changed=[i for i,(x,y) in enumerate(zip(a,b),1) if x"'!=y]
assert set(changed)==allowed,changed
assert len(new)<=len(original)
for i,(x,y) in enumerate(zip(a,b),1):
    if x.startswith(('"'## ','〔圖：','選項：','- ')) or '（唱）' in x or '手錶型 GPS' in x:
        assert x==y,(i,x,y)
    assert re.findall(r'〔(?:圖：["'^〕]+|掉字)〕'"',x)==re.findall(r'〔(?:圖：["'^〕]+|掉字)〕'"',y),(i,x,y)
print(f'修稿包與 canon 原稿一致；只改 {len(changed)} 行：'+ '、'.join(map(str,changed)))
print(f'字元數 {len(original)} → {len(new)}；標題、標記、GPS 扣回句逐字保留。')
print('必修核對：')
for row in re.findall(r'"'^'"\\[(\\d+)\\] 必修 .*"'$'"',Path('審稿/修稿/dark.packet.md').read_text(),re.M):
    print(row)
issues=json.loads(Path('審稿/問題單.json').read_text())
print('閘門第 8、12 行對應問題 id：')
for key,row in issues.items():
    if isinstance(row,dict) and any(x in row.get('quote','') for x in ['余靜：阿哲在顧台','余靜：水我自己拿就好']):
        print(key, json.dumps({k:v for k,v in row.items() if k in ['scene','quote','why','type','status']},ensure_ascii=False))
