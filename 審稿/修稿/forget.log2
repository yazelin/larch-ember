from pathlib import Path
import difflib
import subprocess

lines = Path('canon/劇本.md').read_text().splitlines(keepends=True)
start = next(i for i, line in enumerate(lines) if line.startswith('## forget'))
end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith('## ')), len(lines))
original = ''.join(lines[start:end]).rstrip('\\n')
replacements = [
    ('余靜（心）：剛才那段，不看提詞再寫一次。', '余靜（心）：剛才那段，不看提詞寫一次。'),
    ('旁白：程希敲了兩下門，端著水進來。袖口濕了一片。', '旁白：程希敲了兩下門，端著水進來。'),
    ('余靜：手機拿給我就好，我自己掛。', '余靜：那個……打電話的那個，拿給我，我自己掛。'),
    ('余靜：對不起。報告給我吧，我帶回去看。', '余靜：程希，對不起，讓你擔心了。報告給我吧，我帶回去看。'),
    ('余靜（念）：淑靜，這是 2022 年 3 月，寫給以後的你。', '余靜（念）：淑靜，這是 2022 年 3 月，寫給以後的妳。'),
    ('余靜：我忘了的話，麻煩你拿給我看。', '余靜：我忘了的話，你要拿給我看喔。'),
    ('旁白：程希捲起濕袖口，把收音機放回她面前。', '旁白：程希把收音機放回她面前。'),
]
revised = original
for before, after in replacements:
    assert revised.count(before) == 1, before
    revised = revised.replace(before, after, 1)
original_lines, revised_lines = original.splitlines(), revised.splitlines()
assert len(original_lines) == len(revised_lines)
allowed = dict(replacements)
changed = [(before, after) for before, after in zip(original_lines, revised_lines) if before "'!= after]
assert len(changed) == len(replacements)
assert all(allowed.get(before) == after for before, after in changed)
assert original_lines[0] == revised_lines[0]
assert [line for line in original_lines if line.startswith('"'〔圖：')] == [line for line in revised_lines if line.startswith('〔圖：')]
assert len(revised) <= len(original), (len(original), len(revised))
print(f'Changed lines: {len(changed)}; characters: {len(original)} -> {len(revised)}')
print(''.join(difflib.unified_diff(original_lines, revised_lines, fromfile='original', tofile='revised', lineterm='\\n')))
check = subprocess.run(['/home/ct/speak-tw/bin/speak-tw', '--public', '--stdin'], input=revised + '\\n', text=True, capture_output=True)
print(check.stdout, end='')
print(check.stderr, end='')
print(f'speak-tw exit: {check.returncode}')
assert check.returncode == 0
