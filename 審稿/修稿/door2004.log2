/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import difflib
import re
import subprocess
text = Path('canon/劇本.md').read_text()
scene = re.search(r'"'^## door2004.*?(?=''^## )'"', text, re.M | re.S).group()
changes = [
    ('旁白：余伯坐在台下，人還沒站穩他就先拍起手來。', '旁白：余伯坐在台下，余靜還沒站穩，他就先拍起手來。'),
    ('旁白：她拉過他的手，湊近聞了一下。\\n余靜：阿爸，你又去洗手喔？\\n余伯：臭臊味，洗兩擺矣，猶閣有。（魚腥味，洗兩次了，還是有。）', '余靜：阿爸，你又去洗手喔？\\n余伯：兩擺矣，猶是洗袂掉。（兩次了，還是洗不掉。）\\n旁白：她拉過他的手，湊近聞了一下。'),
    ('旁白：他停了一步，回頭點個頭，才跑進巷子。', '旁白：他停了一步，回頭點個頭，才跑進巷子。\\n余靜：名字！你還沒講名字！'),
    ('余靜：不知道耶。我連名字都忘了問。', '余靜：不知道耶。沒喊住。'),
    ('余靜：阿爸，花幫我拿一下。這雙鞋夾我一整晚了。', '余靜：阿爸，花幫我拿一下。剛剛就該先換鞋。'),
]
revised = scene
for before, after in changes:
    assert revised.count(before) == 1
    revised = revised.replace(before, after, 1)
assert revised.splitlines()[0] == scene.splitlines()[0]
assert re.findall(r'"'^〔圖：.*〕$'"', revised, re.M) == re.findall(r'"'^〔圖：.*〕$'"', scene, re.M)
assert len(revised) <= len(scene), (len(scene), len(revised))
for line in revised.splitlines()[1:]:
    assert not line or line.startswith('〔圖：') or '：' in line, line
print('Length:', len(scene), '->', len(revised))
print(''.join(difflib.unified_diff(scene.splitlines(keepends=True), revised.splitlines(keepends=True), fromfile='original', tofile='revised')))
result = subprocess.run(['/home/ct/speak-tw/bin/speak-tw', '--public', '--stdin'], input=revised, text=True, capture_output=True)
print(result.stdout, end='')
print(result.stderr, end='')
raise SystemExit(result.returncode)
