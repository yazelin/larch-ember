/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import difflib, re
canon = Path('canon/劇本.md').read_text()
original = re.search(r'"'^## forget[''^'"\\n]*\\n[\\s\\S]*?(?="'^## )'"', canon, re.M).group().rstrip() + '\\n'
output = Path('審稿/修稿/forget.md').read_text()
before, after = original.splitlines(), output.splitlines()
assert len(before) == len(after), '行數改變'
changed = [i for i, (a, b) in enumerate(zip(before, after), 1) if a "'!= b]
assert changed == [4, 14, 21, 26, 32, 42, 45, 52], changed
protected = [i for i, s in enumerate(before, 1) if s.startswith(('"'## ', '〔圖', '〔掉字', '選項')) or '（唱）' in s or '敲了兩下' in s or '半分鐘' in s or '淑靜，這是 2022 年 3 月，寫給以後的你。' in s]
assert all(before[i-1] == after[i-1] for i in protected), '保留句被修改'
assert len(output) <= len(original), '長度增加'
print(f'字元數（含格式）：{len(original)} → {len(output)}，減少 {len(original)-len(output)}。')
