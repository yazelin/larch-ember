codex
兩條必修在包內的本場文字已改成「再來一次」與「同一個位置」，會保留。另調整工作人員與周老師各一句，並修掉錄音室結尾的翻頁動作；換鞋等花的心聲、開頭的戒心與對老師的岔題回話都保留，符合這場的節拍。

exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib
import re

root = Path('.')
packet = (root / '審稿/修稿/roses.packet.md').read_text()
block = packet.split('## 這一場（行號｜內容）\\n', 1)[1].split('\\n## 問題：', 1)[0]
numbered = {}
for line in block.splitlines():
    match = re.fullmatch(r'(\\d+)｜(.*)', line)
    if match:
        numbered[int(match[1])] = match[2]
original_lines = [numbered.get(i, '') for i in range(1, max(numbered) + 1)]
original = '\\n'.join(original_lines) + '\\n'
canon_path = root / 'canon/劇本.md'
canon = canon_path.read_text()
canon_scene = re.search(r'"'^## roses[''^'"\\n]*\\n.*?(?="'^## |'"\\Z)', canon, re.M | re.S).group(0)
assert original.rstrip('\\n') == canon_scene.rstrip('\\n'), '修稿包與 canon 本場不一致'

changes = {
    6: '工作人員：不知道。我進來就有了。',
