from pathlib import Path
import re
import difflib
canon=Path('canon/劇本.md').read_text()
old=('## kitchen'+canon.split('## kitchen',1)[1].split('\\n## ',1)[0]).rstrip()+'\\n'
new=Path('審稿/修稿/kitchen.md').read_text()
packet=Path('審稿/修稿/kitchen.packet.md').read_text().split('## 這一場（行號｜內容）\\n',1)[1].split('\\n## 問題：',1)[0]
packet_lines={int(m.group(1)):m.group(2) for line in packet.splitlines() if (m:=re.match(r'"'^('"\\d+)｜(.*)"'$'"',line))}
old_lines=old.splitlines()
new_lines=new.splitlines()
assert all(old_lines[i-1]==line for i,line in packet_lines.items()),'修稿包原稿與 canon 不符'
assert len(old_lines)==len(new_lines)
changed=[i for i,(a,b) in enumerate(zip(old_lines,new_lines),1) if a"'!=b]
assert changed==[15,19,20,26,31,32,33,37],changed
for i in (1,3,4,7,12,25,29,30,35):
    assert old_lines[i-1]==new_lines[i-1],f'"'保護行 {i} 被改動'
assert not re.search(r'"'^'"\\d+｜',new,re.M)
assert new.startswith(old_lines[0]+'\\n\\n')
assert len(new)<=len(old)
assert len(''.join(new.split()))<=len(''.join(old.split()))
assert len(new.encode())<=len(old.encode())
assert '程希（筆記）：10 月 17 日。早上叫我阿希。明天把冰箱旁的矮凳挪開。' in new
print('修稿包與 canon 原稿一致；僅改原稿第 '+', '.join(map(str,changed))+' 行。')
print(f'字元數：{len(old)} → {len(new)}；去空白字元數：{len(\"\".join(old.split()))} → {len(\"\".join(new.split()))}。')
print('保護句、標題、標記及其他行逐字相同。')
print(''.join(difflib.unified_diff(old_lines,new_lines,fromfile='原稿',tofile='kitchen.md',lineterm='\\n')))
