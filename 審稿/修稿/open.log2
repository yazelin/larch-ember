from pathlib import Path
from difflib import unified_diff
canon = Path('canon/劇本.md').read_text()
start = canon.index('## open（')
end = canon.find('\\n## ', start + 1)
original = canon[start:end if end >= 0 else None].rstrip() + '\\n'
revised = Path('審稿/修稿/open.md').read_text()
old_lines = original.splitlines()
new_lines = revised.splitlines()
assert len(old_lines) == len(new_lines), '行數變動'
changes = [(i, before, after) for i, (before, after) in enumerate(zip(old_lines, new_lines), 1) if before "'!= after]
assert [i for i, _, _ in changes] == [22], changes
assert len(revised) <= len(original), '"'長度增加'
assert new_lines[26] == '余靜：先生，這張……算了。'
assert new_lines[13] == '旁白：她喝了一口，肩膀垂下。她把杯子遞向他，又停住了。'
assert new_lines[14] == old_lines[14]
assert new_lines[27] == old_lines[27]
print(''.join(unified_diff(old_lines, new_lines, fromfile='canon/劇本.md 的 open', tofile='審稿/修稿/open.md', lineterm='\\n')))
print(f'檢查通過：僅第 22 行改動；字元數 {len(original.rstrip())} → {len(revised.rstrip())}；其餘逐字一致。')
