/bin/bash -lc "python3 -B - <<'PY'
from pathlib import Path
import re
canon = Path('canon/劇本.md').read_text()
start = canon.index('## open（')
original = canon[start:canon.index('\\n## ', start + 1)].rstrip('\\n') + '\\n'
revised = Path('審稿/修稿/open.md').read_text()
expected_changes = {
    '男人：我是這裡的工作人員。送水來的。': '男人：我是這裡的工作人員，來送水的。',
    '余靜：不好意思，怎麼就拿給你了。我自己放。': '余靜：不好意思，我自己放就好。',
    '旁白：鏡角貼著一張照片。她湊近，看了看照片裡白襯衫男人的臉。': '旁白：鏡子角落貼著一張照片。她湊近，看了看照片裡白襯衫男人的臉。',
}
old_lines, new_lines = original.splitlines(), revised.splitlines()
assert len(old_lines) == len(new_lines)
changed = []
for number, (old, new) in enumerate(zip(old_lines, new_lines), 1):
    if old "'!= new:
        assert expected_changes.get(old) == new, (number, old, new)
        changed.append(number)
assert len(changed) == len(expected_changes)
assert len(revised) <= len(original)
for number, line in enumerate(old_lines, 1):
    if re.search(r'"'"'^## |〔圖〕|〔圖：|〔掉字〕|（唱）|''^選項：|敲了兩下|半分鐘|保溫杯|我乾脆把時鐘掛脖子上好了'"', line):
        assert new_lines[number - 1] == line, (number, line)
print(f'僅改原稿第 {\"、\".join(map(str, changed))} 行；其餘各行逐字一致。')
print(f'字元數（含標點與換行）：{len(original)} → {len(revised)}；標題、圖標記、扣回句與原稿自嘲均保留。')
