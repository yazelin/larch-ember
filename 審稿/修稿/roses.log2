draft = \"## roses（2006 至 2008 年，各地後台門口與錄音室）\\n\\n〔圖：s_roses_1〕\\n旁白：2006 年，散場後。後台門外右邊放著一朵深紅玫瑰，花梗夾著當晚的票根。\\n余靜：塞花就跑的？\\n場務：又是那個少年仔，交給我就走了。\\n余靜：下次叫他買三排十四號啦，我要找得到他。\\n旁白：她笑著往走廊看，才彎腰拿花。\\n旁白：隔週台北，再下一場嘉義。她對著三排十四號唱，散場後門外右邊都有一朵。\\n旁白：2007 年，高雄。她走到門邊，先往右邊看，地上沒有花。\\n余靜：我譜還沒收，你們先走。\\n旁白：她回到桌邊，拿起歌譜。周老師停在門邊。\\n周老師：又往三排十四號看，拍子不管啦？\\n余靜：第二段我又趕了。老師，下一場幫我拉住拍子。\\n余靜（心）：今天還沒放。換完鞋再看。\\n\\n〔圖：s_studio_1〕\\n旁白：2008 年，錄音室。歌詞紙上寫著「餘燼」。\\n余靜：（唱）燈一盞一盞暗下來\\n余靜：（唱）掌聲退回了街上\\n余靜：（唱）我把最後一個字收好\\n余靜：（唱）門口又有一朵紅\\n余靜：（唱）沒有名字 沒有卡片\\n余靜：（唱）花瓣上的露水還沒乾\\n余靜：（唱）是誰在散場以後\\n余靜：（唱）還不肯走\\n余靜：（唱）我不認得你的臉\\n余靜：（唱）卻認得你的安靜\\n余靜：（唱）如果我是一場餘燼\\n余靜：（唱）你是最後熄燈的人\\n余靜：（唱）台下坐滿了陌生人\\n余靜：（唱）只有一個位子 等得那麼認真\\n余靜：（唱）就算天黑了 全世界都散了\\n余靜：（唱）我還有一點紅 替你留著\\n余靜：（唱）不肯冷\\n余靜：再來一次。「門口」我唱太重了。\\n旁白：她喝了口水，把「門口」圈起來。\\n\"
source = Path('canon/劇本.md').read_text()
m = re.search(r'"'^## roses[''^'"\\n]*\\n.*?(?="'^## |'"\\Z)', source, re.M | re.S)
original = m.group()
assert original.splitlines()[0] == draft.splitlines()[0]
sung = lambda text: [x for x in text.splitlines() if '（唱）' in x]
assert sung(original) == sung(draft)
markers = lambda text: re.findall(r'〔圖：["'^〕]+〕'"', text)
assert markers(original) == markers(draft)
assert draft.index('〔圖：s_roses_1〕') < draft.index('旁白：2006')
assert draft.index('〔圖：s_studio_1〕') < draft.index('旁白：2008') < draft.index('余靜：（唱）')
assert len(re.sub(r'\\s+', '', draft)) <= len(re.sub(r'\\s+', '', original))
assert '旁白：她回到桌邊，拿起歌譜。周老師停在門邊。' in draft
assert '旁白：2007 年，高雄。她走到門邊，先往右邊看，地上沒有花。' in draft
assert '余靜：第二段我又趕了。老師，下一場幫我拉住拍子。' in draft
assert all('：' in line for line in draft.splitlines()[1:] if line.strip() and not line.startswith('〔圖：'))
patched = source[:m.start()] + draft + '\\n' + source[m.end():]
lint = subprocess.run(['/home/ct/speak-tw/bin/speak-tw','--stdin','--public'], input=draft, text=True, capture_output=True)
motif = subprocess.run(['python3','tests/motif_check.py','/dev/stdin'], input=patched, text=True, capture_output=True)
print('標題、圖標記、17 行歌詞與保留句檢查通過；字數', len(re.sub(r'\\s+', '', draft)))
print(lint.stdout.strip(), 'exit', lint.returncode)
print(motif.stdout.strip().splitlines()[-1] if motif.stdout.strip() else motif.stderr, 'exit', motif.returncode)
assert lint.returncode == 0
assert motif.returncode == 0

