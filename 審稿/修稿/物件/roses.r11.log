original = re.search(r'"'^## roses[''^'"\\n]*\\n.*?(?="'^## )'"', script, re.M | re.S).group().rstrip()
changes = {
    '余靜：下次叫他買三排十四號啦，這樣我才找得到人。': '余靜：下次叫他等我一下啦。',
    '旁白：隔週台北，再下一場嘉義。她對著三排十四號唱，散場後門口都有一朵。': '旁白：隔週台北，再下一場嘉義。散場後門口都有一朵。',
    '周老師：前奏我多彈了一遍，妳還在看三排十四號。': '周老師：我先去車上等妳喔。',
    '余靜：有聽到啦。老師，下次我看你再開口。': '余靜：我換個鞋就來。',
}
candidate = original
