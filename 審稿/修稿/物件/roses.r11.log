assert [s for s in candidate.splitlines() if '（唱）' in s or s.startswith('〔圖：')] == [s for s in original.splitlines() if '（唱）' in s or s.startswith('〔圖：')]
assert sum(a "'!= b for a, b in zip(candidate.splitlines(), original.splitlines())) == 4
assert '"'三排十四號' not in candidate
result = subprocess.run(['/home/ct/speak-tw/bin/speak-tw', '--public', '--stdin'], input=candidate + '\\n', text=True, capture_output=True)
print(result.stdout, end='')
if result.stderr:
    print(result.stderr, end='')
if result.returncode:
    raise SystemExit(result.returncode)
print(candidate)
