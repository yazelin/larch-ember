 succeeded in 0ms:
src/build.py:32:GALLERY = [('s_mem1_3', '2004，玫瑰與票根'), ('s_mem2_6', '票根的背面'), ('s_mem2_11', '2013，空舞台上的一小段舞'),

exec
/bin/bash -lc "python3 -c 'import re, subprocess
from pathlib import Path
draft = \"## confess（2011 年後台門口與收音機，2013 年空舞台）\\n\\n〔圖：s_mem2_7〕\\n旁白：2011 年，高雄。散場後，余靜還沒卸妝就走到後台門口。程希正在收線。\\n余靜：你 2009 年來跟巡演，門口的花就沒了。\\n旁白：程希抬起頭。\\n余靜：三排十四號也是那時候開始空著。我還以為那個人不來聽了。\\n旁白：她走到他面前，看著他的臉。\\n余靜：2004 年，我在門口認出你是河岸坐角落那個。名字還沒問到，你就跑了。\\n余靜：程希，那些花都是你放的，對不對？\\n程希：是我。\\n旁白：他把手裡的線放進器材箱。\\n余靜：結果你跑來幫我顧音響了。\\n程希：我本來就做音響啊，電器行學徒出來的。2009 年剛好缺人，朋友找我來。\\n余靜：那後來怎麼不送花了？\\n程希：每天都見得到妳，收完線妳也還沒走。就沒去買了。\\n旁白：余靜低頭看了看箱子。\\n余靜：收完一起去吃飯，我等你。\\n程希：還有一箱，等我一下。\\n旁白：她站到門邊，程希合上箱蓋。\\n\\n〔圖：s_mem2_10〕\\n旁白：2013 年，永明戲院空舞台。余靜穿淺色洋裝，程希穿白襯衫，周老師在第一排拿著相機。\\n余靜：拍結婚照耶，你站那麼遠幹嘛。\\n程希：怕踩到妳裙子啊。\\n旁白：她拉住他的袖口，把他拉到身邊。\\n周老師：新郎看鏡頭啦。還在看她喔。\\n旁白：周老師按下快門，程希的臉朝著她。\\n\\n〔圖：s_mem2_11〕\\n程希：陪我跳一下。\\n余靜：腳都站痠了，還要跳喔。\\n程希：就一下，我練過。\\n旁白：他牽起她的手，另一隻手扶住她的腰。\\n程希：（哼）燈一盞一盞暗下來\\n旁白：她踏出一步，他就踩到裙邊。他趕緊移開腳。\\n余靜：你唱歌也走音了。\\n程希：我一唱，腳就亂了。\\n余靜：那我唱，你跳。\\n余靜：（唱）燈一盞一盞暗下來\\n旁白：他抬起腳。她拉著他再走一步。\\n\"
canon = Path('\"'\"'canon/劇本.md'\"'\"').read_text()
old = re.search(r'\"'\"'"'^## confess[''^'"\\n]*[\\s\\S]*?(?="'^## |'"\\Z)'\"'\"', canon, re.M).group(0)
assert draft.splitlines()[0] == old.splitlines()[0]
anchor = '\"'\"'〔圖：s_mem2_10〕'\"'\"'
assert draft[draft.index(anchor):].rstrip() == old[old.index(anchor):].rstrip(), '\"'\"'2013 年段落有變動'\"'\"'
assert len(draft.splitlines()) < len(old.splitlines()), '\"'\"'行數未縮短'\"'\"'
assert set(re.findall(r'\"'\"'〔圖：["'^〕]+〕'"'\"'\"', draft)) <= set(re.findall(r'\"'\"'〔圖：["'^〕]+〕'"'\"'\"', old))
