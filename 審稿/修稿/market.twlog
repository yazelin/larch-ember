/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import difflib
import subprocess

text = Path('canon/劇本.md').read_text()
start = text.index('## market（')
end = text.index('\\n## ', start + 1)
original = text[start:end].rstrip('\\n')
old = '''淑靜：（唱）天烏烏，欲落雨。（天黑黑，要下雨。）
余伯：（唱）阿公仔舉鋤頭欲掘芋。（阿公拿鋤頭要挖芋頭。）
淑靜：（唱）阿公仔舉鋤頭欲掘芋。（阿公拿鋤頭要挖芋頭。）'''
new = '旁白：父女一句接一句唱下去。'
assert original.count(old) == 1
revised = original.replace(old, new)
assert revised.count('（唱）天烏烏') == 1
print(''.join(difflib.unified_diff(original.splitlines(True), revised.splitlines(True), fromfile='原文', tofile='修稿')))
result = subprocess.run(['/home/ct/speak-tw/bin/speak-tw', '--stdin', '--public'], input=revised + '\\n', text=True, capture_output=True)
print(result.stdout, end='')
print(result.stderr, end='')
print(f'speak-tw exit: {result.returncode}')
print('\\n'.join(line for line in revised.splitlines() if line))
