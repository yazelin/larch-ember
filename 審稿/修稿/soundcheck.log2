aw/standee/_old_dr/dr_lin_4.json␀?? art/raw/standee/_old_dr/dr_lin_4.png␀?? art/voice-test/cand/␀?? art/voice-test/samples/␀?? art/voice-test/taigi/vc-long-antie.wav␀?? art/voice-test/taigi/vc-long-aunt.wav␀?? art/voice-test/taigi/vc-long-child.wav␀?? art/voice-test/taigi/vc-long-dad.wav␀?? canon/歌詞-港邊的燈-suno音近.md␀?? design/歌詞接線/codex.err␀?? design/歌詞接線/codex.out␀?? design/歌詞接線/codex2.err␀?? design/歌詞接線/codex2.out␀?? design/歌詞重寫/␀?? design/結局C修改.md␀?? design/編輯意見/␀?? ui/mockup/mockup.png␀?? 審稿/修稿/dark.log2␀?? 審稿/修稿/kitchen.log2␀?? 審稿/修稿/kitchen.r1.md␀?? 審稿/修稿/kitchen.report2.md␀?? 審稿/修稿/monitor.log2␀?? 審稿/修稿/monitor.r1.md␀?? 審稿/修稿/open.log2␀?? 審稿/修稿/open.r1.md␀?? 審稿/修稿/open.report2.md␀?? 審稿/修稿/soundcheck.log2␀?? 審稿/修稿/soundcheck.r1.md␀
exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import re

canon = Path('canon/劇本.md').read_text()
match = re.search(r'"'^## soundcheck[''^'"\\n]*\\n[\\s\\S]*?(?="'^## |'"\\Z)', canon, re.M)
assert match is not None
original = match.group(0).rstrip('\\n') + '\\n'
changes = {
    '余靜：2004 年那場，老師也是坐這裡。後來我還有回來唱嗎？': '余靜：2004 年那場，老師也是坐這裡。後來那場，老師也在吧？',
    '周老師：有啊，後來又唱過。先試第一段。': '周老師：有啊。先試第一段。',
    '旁白：她吸了一口氣，嘴唇動了，麥克風仍停在嘴邊。': '旁白：她吸了一口氣，嘴唇動了動。',
    '余靜：忘自己的詞，要扣多少錢啊？': '余靜：忘自己的詞，真有我的。',
    '旁白：程希走到三排十四號坐下。她的手從耳墜移到胸前。': '旁白：程希走到三排十四號坐下。余靜把手從耳墜移到胸前。',
    '余靜（心）：胸口怎麼這麼緊。想唱給他聽。': '余靜（心）：胸口怎麼這麼緊。又讓人等了。',
    '余靜：那位先生，能聽我唱一段嗎？': '余靜：那位先生，不好意思，還得再試一次。',
}
revised = original
for old, new in changes.items():
    assert revised.count(old) == 1, old
    revised = revised.replace(old, new, 1)
assert len(revised) <= len(original)
assert len(revised.splitlines()) == len(original.splitlines())
for old, new in zip(original.splitlines(), revised.splitlines()):
    assert old == new or changes.get(old) == new
    if old.startswith(('## ', '〔圖', '〔掉字')) or '：（唱）' in old:
        assert old == new, old
assert '程希走到三排十四號坐下。' in revised
assert '旁白：她唱完，仍握著耳墜，沒再開口。' in revised
Path('審稿/修稿/soundcheck.md').write_text(revised)
print(f'原稿 {len(original)} 字元；修稿 {len(revised)} 字元；共改 {len(changes)} 行。')
