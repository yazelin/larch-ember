new_cjk = sum('\\u4e00' <= c <= '\\u9fff' for c in new)
assert new_cjk <= old_cjk, '中文字數增加'
print(f'字元數：{len(old)} → {len(new)}；中文字數：{old_cjk} → {new_cjk}；行數：{len(new.splitlines())}')
print('標題、唱句、圖標記、扣回句子保留；僅改被點到的行。')
print(''.join(difflib.unified_diff(old.splitlines(keepends=True), new.splitlines(keepends=True), fromfile='原稿', tofile='soundcheck.md')))
