packet_lines = {int(n): text for n, text in re.findall(r'"'^('"\\d+)｜(.*)"'$'"', p, re.M)}
for n, text in packet_lines.items():
    assert old.splitlines()[n - 1] == text, f'原稿與修稿包不同：行 {n}'
protected = lambda text: [line for line in text.splitlines() if line.startswith('## ') or '（唱）' in line or '〔圖' in line or '〔掉字〕' in line or line.startswith(('選項：', '- '))]
assert protected(old) == protected(new), '標題、唱句或標記遭改動'
