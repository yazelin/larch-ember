/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import difflib
import subprocess

source = Path('canon/劇本.md').read_text()
start = source.index('## confess（')
end = source.index('\\n## ', start + 1)
original = source[start:end].rstrip() + '\\n'
replacements = [
    ('程希：有上班的場，我不送。妳不要，我就不放了。\\n', ''),
    ('余靜：我拿。耳返壞掉那次，在側台的也是你。', '余靜：我拿。'),
    ('程希：淑靜，試一口？', '程希：余靜，試一口？'),
    ('程希：我比妳知道線在哪裡。', '程希：線在哪裡，我比妳清楚。'),
]
revised = original
for old, new in replacements:
    assert revised.count(old) == 1, old
    revised = revised.replace(old, new, 1)
assert original.splitlines()[0] == revised.splitlines()[0]
assert len(revised) <= len(original)
for line in revised.splitlines()[1:]:
    assert not line or line.startswith('〔圖：') or '：' in line, line
print(''.join(difflib.unified_diff(original.splitlines(True), revised.splitlines(True), fromfile='原文', tofile='修稿')), end='')
result = subprocess.run(['/home/ct/speak-tw/bin/speak-tw', '--public', '--stdin'], input=revised, text=True, capture_output=True)
print(result.stdout, end='')
print(result.stderr, end='')
raise SystemExit(result.returncode)
