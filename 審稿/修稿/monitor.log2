exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
for p in (Path('/AGENTS.md'), Path('/home/AGENTS.md'), Path('/home/ct/AGENTS.md'), Path('/home/ct/larch-ember/AGENTS.md'), Path('/home/ct/larch-ember/審稿/AGENTS.md'), Path('/home/ct/larch-ember/審稿/修稿/AGENTS.md')):
    if p.is_file():
