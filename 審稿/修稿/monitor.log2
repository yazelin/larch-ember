from pathlib import Path
import hashlib,json,re
canon=Path('canon/劇本.md').read_text()
a=canon.index('## monitor')
b=canon.find('\\n## ',a+1)
original=canon[a:b if b "'!= -1 else None].rstrip()+'"'\\n'
new=Path('審稿/修稿/monitor.md').read_text()
packet=Path('審稿/修稿/monitor.packet.md').read_text().split('## 這一場（行號｜內容）\\n',1)[1].split('\\n## 問題：',1)[0]
numbered={int(m.group(1)):m.group(2) for line in packet.splitlines() if (m:=re.match(r'"'^('"\\d+)｜(.*)"'$'"',line))}
packet_lines=[numbered.get(i,'') for i in range(1,max(numbered)+1)]
assert original.splitlines()==packet_lines,'canon 與修稿包原稿不同'
old_lines=original.splitlines()
new_lines=new.splitlines()
assert len(old_lines)==len(new_lines)
changed=[i+1 for i,(x,y) in enumerate(zip(old_lines,new_lines)) if x"'!=y]
assert changed==[25,31,36],changed
assert len(new)<=len(original),(len(original),len(new))
protected=lambda lines:[s for s in lines if s.startswith('"'## ') or '（唱）' in s or '〔圖' in s or '〔掉字' in s or '四折歌譜' in s]
assert protected(old_lines)==protected(new_lines),'保護句有變動'
print(f'與修稿包原稿相符；只改 {changed} 三行；原稿 {len(original)} 字，新稿 {len(new)} 字（均含標點與換行）。')
print('唱句、扣回物件、標題與標記均未變動。')
for i in changed:
    print(f'行{i}：{old_lines[i-1]}\\n  → {new_lines[i-1]}')
paths=['canon/劇本.md','審稿/修稿/monitor.packet.md','審稿/修稿/monitor.gate.txt','審稿/修稿/monitor.r1.md']
print(json.dumps({p:hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in paths},ensure_ascii=False))
