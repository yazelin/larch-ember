/bin/bash -lc "python3 -B - <<'PY'
from pathlib import Path
import difflib
packet = Path('審稿/修稿/monitor.packet.md').read_text()
section = packet.split('## 這一場（行號｜內容）\\n', 1)[1].split('\\n## 問題：', 1)[0]
numbered = {}
for line in section.splitlines():
    if '｜' in line:
        n, value = line.split('｜', 1)
        if n.isdigit():
            numbered[int(n)] = value
original = '\\n'.join(numbered.get(n, '') for n in range(1, max(numbered)+1)) + '\\n'
script = Path('canon/劇本.md').read_text()
a = script.index('## monitor')
b = script.find('\\n## ', a + 1)
canon = script[a:b if b "'!= -1 else None].rstrip() + '"'\\n'
assert original == canon, '修稿包與 canon 原稿不同'
result = Path('審稿/修稿/monitor.md').read_text()
old, new = original.splitlines(), result.splitlines()
assert len(new) == len(old)
assert len(result) <= len(original)
protected = lambda s: s.startswith(('## ', '〔圖', '〔掉字', '選項', '- [', '* [')) or '（唱）' in s or '四折歌譜' in s
for n, (a, b) in enumerate(zip(old, new), 1):
    if protected(a):
        assert a == b, f'第 {n} 行保護句改動'
allowed = {24,25,26,27,29,31,34,36,41,42,43,44}
changed = {n for n, (a,b) in enumerate(zip(old,new),1) if a"'!=b}
assert changed <= allowed, f'"'改到範圍外：{changed-allowed}'
print('原稿與修稿包相符；保護句逐字相同；變動僅限被點到的句子與相鄰句。')
print(f'字元（含格式）：{len(original)} → {len(result)}，減少 {len(original)-len(result)}。')
print('變動行：'+ '、'.join(map(str,sorted(changed))))
print(''.join(difflib.unified_diff(old,new,fromfile='原稿',tofile='monitor.md',lineterm='\\n')))
