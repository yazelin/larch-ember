from pathlib import Path
import re
import subprocess
text = Path('canon/劇本.md').read_text()
scene = re.search(r'"'^## concert[''^'"\\n]*\\n(?P<body>.*?)(?="'^## |'"\\Z)', text, re.M | re.S).group(0).rstrip('\\n')
old = '旁白：她抬頭望向第三排。程希坐在十四號，玫瑰放在膝上。'
new = '旁白：她抬頭望向第三排。程希在十四號起身，手握著玫瑰。'
assert scene.count(old) == 1
revised = scene.replace(old, new)
assert len(new) == len(old)
assert [(a,b) for a,b in zip(scene.splitlines(),revised.splitlines()) if a "'!= b] == [(old,new)]
result = subprocess.run(['"'/home/ct/speak-tw/bin/speak-tw', '--stdin', '--public'], input=revised, text=True, capture_output=True)
print(result.stdout)
if result.stderr:
    print(result.stderr)
print('speak-tw exit:', result.returncode)
print(revised)
