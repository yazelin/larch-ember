from pathlib import Path
import hashlib, json, re
p = Path('審稿/修稿/canal.md')
packet = Path('審稿/修稿/canal.packet.md').read_text()
section = packet.split('## 這一場（行號｜內容）\\n',1)[1].split('\\n## 問題：',1)[0]
rows = {int(m[1]):m[2] for line in section.splitlines() if (m := re.match(r'(\\d+)｜(.*)',line))}
old_lines = [rows.get(i,'') for i in range(1,max(rows)+1)]
new = p.read_text()
new_lines = new.splitlines()
changed = [i for i,(a,b) in enumerate(zip(old_lines,new_lines),1) if a"'!=b]
assert len(old_lines)==len(new_lines)==53
assert changed == [7,12,16,17,23,42,45]
assert len(new) <= len('"'\\n'.join(old_lines)+'\\n')
for i, line in enumerate(old_lines):
    if line.startswith(('## ', '〔圖', '〔掉字', '選項：', '- ')) or any(x in line for x in ['（唱）','天烏烏','〔掉字〕']):
