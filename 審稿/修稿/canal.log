        except FileNotFoundError:
            continue
        states[str(p)] = [s.st_mtime_ns, s.st_size]
canon_hash = hashlib.sha256(Path('canon/劇本.md').read_bytes()).hexdigest()
packet_hash = hashlib.sha256(Path('審稿/修稿/canal.packet.md').read_bytes()).hexdigest()
target.write_text(new)
print(json.dumps({'original_chars':len(old),'revised_chars':len(new),'changed_packet_lines':list(changes),'canon_sha256':canon_hash,'packet_sha256':packet_hash,'file_states_before':states}, ensure_ascii=False))
