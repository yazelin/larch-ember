assert all(a == b for i,(a,b) in enumerate(zip(original,revised),1) if i not in changes)
canon = Path('canon/劇本.md').read_text()
canon_scene = re.search(r'"'^## canal（.*?(?=''^## |'"\\Z)', canon, re.S|re.M).group().rstrip('\\n')
assert canon_scene == old.rstrip('\\n'), '修稿包與 canon 的本場不同。'
