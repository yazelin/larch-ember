    42: '旁白：她抬頭看他，手往回縮。',
    45: '余靜：（笑）認錯了，對不起。阿爸還在下面？',
}
revised = original.copy()
for line, replacement in changes.items():
    revised[line-1] = replacement
old = '\\n'.join(original)+'\\n'
new = '\\n'.join(revised)+'\\n'
assert len(new) <= len(old), (len(old), len(new))
assert len(revised) == len(original)
protected = lambda s: s.startswith(('## ', '〔圖', '〔掉字', '選項：', '- ')) or any(w in s for w in ['（唱）', '天烏烏', '〔掉字〕'])
