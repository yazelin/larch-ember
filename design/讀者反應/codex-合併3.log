from pathlib import Path
import re
p=Path('canon/劇本-合併稿3.md')
t=p.read_text(encoding='utf-8')
base=Path('canon/劇本.md').read_text(encoding='utf-8')
def locate(text,key,nth=1):
    heads=[(m.start(),m.end()) for m in re.finditer(r'(?m)"'^## '"',text) if text.startswith('## '+key+'（',m.start()) or text.startswith('## '+key+' ',m.start())]
    if len(heads)<nth: raise SystemExit(f'{key}: only {len(heads)} matches, need {nth}')
    start,hend=heads[nth-1]
    nxt=re.search(r'(?m)"'^## '"',text[hend:])
    end=hend+nxt.start() if nxt else len(text)
    return start,end
def get_section(text,key,nth=1):
    a,b=locate(text,key,nth)
    return text[a:b].rstrip()
def replace_nth(text,key,new,nth=1):
    a,b=locate(text,key,nth)
    return text[:a]+new.rstrip()+'\\n\\n'+text[b:]
